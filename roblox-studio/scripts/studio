#!/usr/bin/env bash
# Point d'entrée unique du pipeline déterministe.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Python : le .venv de CE studio s'il existe (cohabitation avec le studio Blender), sinon STUDIO_PYTHON, sinon python3
if [ -x "$ROOT/.venv/bin/python" ]; then PY="$ROOT/.venv/bin/python"; else PY="${STUDIO_PYTHON:-python3}"; fi
exec env PYTHONPATH="$ROOT/pipeline${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m studio "$@"
