{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.local/schemas/episode_brief.schema.json",
  "title": "episode_brief.json — demande créative initiale",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": ["contract", "source_story", "target_duration_s", "style", "language"],
  "properties": {
    "contract": {"const": "episode_brief"},
    "title_hint": {"type": "string"},
    "source_story": {"type": "string", "minLength": 20},
    "source_kind": {"enum": ["original_user_story", "idea", "reddit_style_paraphrase", "other"]},
    "target_duration_s": {"type": "number", "minimum": 8, "maximum": 180},
    "duration_tolerance_s": {"type": "number", "minimum": 0, "default": 10},
    "language": {"const": "fr-FR"},
    "style": {
      "type": "object",
      "required": ["visual", "tone"],
      "properties": {
        "visual": {"type": "string"},
        "tone": {"type": "array", "items": {"type": "string"}},
        "references_to_avoid_copying": {"type": "array", "items": {"type": "string"}}
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "narrator_gender": {"enum": ["male", "female", "any"]},
        "energy": {"enum": ["calm", "lively", "deadpan", "hyper"]}
      }
    },
    "deliverables": {
      "type": "array",
      "items": {"enum": ["script", "storyboard", "lookdev", "prototype", "first_cut", "final"]}
    },
    "stop_after": {"enum": ["script", "storyboard", "lookdev", "prototype", "first_cut", "final"], "description": "Dernière étape autorisée sans nouvelle instruction humaine."},
    "content_constraints": {"type": "array", "items": {"type": "string"}}
  }
}
