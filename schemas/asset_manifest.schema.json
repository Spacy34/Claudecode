{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.local/schemas/asset_manifest.schema.json",
  "title": "asset_manifest.json — décors et accessoires de l'épisode",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "required": [
    "contract",
    "sets",
    "props"
  ],
  "$defs": {
    "prop_type": {
      "enum": [
        "sofa",
        "table",
        "chair",
        "tv",
        "fridge",
        "stove",
        "counter",
        "toaster",
        "plant",
        "lamp",
        "door",
        "window",
        "car",
        "tree",
        "bush",
        "bench",
        "desk",
        "computer",
        "phone",
        "mug",
        "bed",
        "toilet",
        "box",
        "trash_can",
        "cake",
        "sign",
        "pigeon",
        "cat",
        "frying_pan",
        "fire_extinguisher",
        "shopping_cart",
        "shelf",
        "rug",
        "streetlight",
        "building",
        "painting",
        "restaurant_table",
        "wine_glass",
        "plate_food",
        "menu_board",
        "cooking_pot",
        "school_desk",
        "blackboard",
        "backpack",
        "globe",
        "parasol",
        "beach_towel",
        "sandcastle",
        "palm_tree",
        "beach_ball",
        "surfboard",
        "cooler",
        "lifeguard_tower",
        "dog",
        "chicken",
        "duck",
        "rat",
        "fish",
        "cow",
        "guitar",
        "pizza",
        "burger",
        "trophy",
        "money_stack",
        "skateboard",
        "bucket",
        "custom",
        "composite"
      ]
    },
    "placement": {
      "type": "object",
      "required": [
        "type",
        "pos"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/prop_type"
        },
        "pos": {
          "$ref": "common.schema.json#/$defs/vec2"
        },
        "rot_deg": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5
        },
        "color": {
          "$ref": "common.schema.json#/$defs/color"
        },
        "label": {
          "type": "string",
          "maxLength": 24
        },
        "parts": {
          "$ref": "#/$defs/parts"
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "Objet improvisé (type composite) : assemblage de formes simples. Origine = sol, avant = -Y, mètres.",
      "items": {
        "type": "object",
        "required": [
          "shape",
          "size",
          "pos"
        ],
        "additionalProperties": false,
        "properties": {
          "shape": {
            "enum": [
              "box",
              "ball",
              "cyl",
              "cone",
              "torus",
              "text"
            ]
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "box : dimensions x,y,z ; ball : diamètres ; cyl : [diamètre bas, diamètre haut, hauteur] ; cone : [diamètre base, 0, hauteur] ; torus : [diamètre, diamètre, épaisseur] ; text : [taille, 0, 0]"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "centre de la pièce (x, y, z)"
          },
          "rot_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          },
          "glow": {
            "type": "boolean",
            "description": "matière lumineuse (écran, néon, flamme)"
          },
          "text": {
            "type": "string",
            "maxLength": 24
          },
          "ink": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "properties": {
    "contract": {
      "const": "asset_manifest"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kit",
          "source",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/set_id"
          },
          "kit": {
            "enum": [
              "living_room",
              "kitchen",
              "bedroom",
              "bathroom",
              "office",
              "street",
              "park",
              "supermarket",
              "studio_void",
              "restaurant",
              "classroom",
              "beach",
              "car_interior",
              "generic_interior",
              "generic_exterior"
            ]
          },
          "description": {
            "type": "string"
          },
          "size": {
            "$ref": "common.schema.json#/$defs/vec2",
            "description": "largeur x profondeur en mètres"
          },
          "palette": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "wall": {
                "$ref": "common.schema.json#/$defs/color"
              },
              "floor": {
                "$ref": "common.schema.json#/$defs/color"
              },
              "accent": {
                "$ref": "common.schema.json#/$defs/color"
              },
              "sky": {
                "$ref": "common.schema.json#/$defs/color"
              }
            }
          },
          "use_kit_dressing": {
            "type": "boolean",
            "default": true
          },
          "dressing": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/placement"
            }
          },
          "marks": {
            "type": "object",
            "description": "Repères nommés (x, y) en mètres ; y positif = vers le fond.",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/vec2"
            }
          },
          "source": {
            "enum": [
              "procedural",
              "library",
              "external"
            ]
          },
          "license": {
            "$ref": "common.schema.json#/$defs/license"
          },
          "seed": {
            "type": "integer"
          },
          "surfaces": {
            "type": "object",
            "additionalProperties": false,
            "description": "Motifs du sol/murs (obligatoire pour generic_*, sinon surcharge du kit).",
            "properties": {
              "floor": {
                "enum": [
                  "planks",
                  "tiles",
                  "noise",
                  "grass",
                  "bricks",
                  "wood",
                  "stripes"
                ]
              },
              "wall": {
                "enum": [
                  "planks",
                  "tiles",
                  "noise",
                  "grass",
                  "bricks",
                  "wood",
                  "stripes"
                ]
              },
              "wainscot": {
                "type": "boolean"
              }
            }
          },
          "backdrop": {
            "type": "array",
            "items": {
              "enum": [
                "skyline",
                "hills",
                "trees",
                "sea",
                "clouds"
              ]
            },
            "uniqueItems": true,
            "description": "Arrière-plans de generic_exterior (couches lointaines)."
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/prop_id"
          },
          "type": {
            "$ref": "#/$defs/prop_type"
          },
          "color": {
            "$ref": "common.schema.json#/$defs/color"
          },
          "scale": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 5
          },
          "label": {
            "type": "string",
            "maxLength": 24
          },
          "hero": {
            "type": "boolean",
            "description": "Accessoire clé de l'histoire : doit être lisible à taille téléphone."
          },
          "source": {
            "enum": [
              "procedural",
              "library",
              "external"
            ]
          },
          "external_path": {
            "type": "string",
            "description": "Chemin RELATIF à assets/ d'un modèle .glb/.gltf/.obj (source external). Ajouté via `studio asset-add`."
          },
          "license": {
            "$ref": "common.schema.json#/$defs/license"
          },
          "target_height": {
            "type": "number",
            "minimum": 0.02,
            "maximum": 20,
            "description": "Hauteur finale en mètres (normalisation de l'échelle du modèle externe)."
          },
          "rot_offset_deg": {
            "type": "number",
            "description": "Rotation Z corrective du modèle externe (pour qu'il regarde -Y)."
          },
          "parts": {
            "$ref": "#/$defs/parts"
          }
        }
      }
    }
  }
}